# Cortex hub settings: copy to .env and edit. Changing the address or the domain makes a new local CA to trust again.

# Scope. 127.0.0.1 = this machine only. To open it to the local network, put this machine's private LAN address
# (for example 192.168.1.20): browsers then sign in with the access key in <vaults>/.cortex-hub/access.key.
# Public addresses are refused.
CORTEX_ADDRESS=127.0.0.1

# The name browsers use; the certificate covers it, the address and every agent's own host <agent>.<domain>
# (claude.cortex.localhost opens Claude Cortex's panel). Localhost scope: cortex.localhost, which with all its
# subdomains resolves to this machine by itself (.local does not: it is mDNS, one hosts entry per agent).
# LAN scope: a name whose subdomains your router's DNS points at the address (a wildcard), such as cortex.lan.
CORTEX_DOMAIN=cortex.localhost

# 443 and 80: no port in the address bar (80 only redirects to HTTPS). Pick others if something already uses them.
CORTEX_PORT=443
CORTEX_HTTP_PORT=80

# The folder that holds every agent's cortex, the same on every system: ~/Vaults (Linux, macOS) or
# %USERPROFILE%\Vaults (Windows). Create it before the first start. Uncomment only to move it.
# CORTEX_VAULTS=/home/me/Vaults

# Linux: your user and group ids (`id -u`, `id -g`), so the vaults the hub creates are yours.
CORTEX_UID=1000
CORTEX_GID=1000

# Written into new vaults: the owner's name in AGENTS.md, and the git identity of the first commit.
CORTEX_OWNER=the owner
CORTEX_GIT_NAME=
CORTEX_GIT_EMAIL=
